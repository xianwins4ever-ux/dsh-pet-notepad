{
  "name": "@dsh-external/dsh-pet-notepad",
  "version": "0.1.0",
  "description": "DSH Web GUI 桌宠伴生记事本：右键宠物弹出悬浮记事本，左侧栏「记事本」入口可查看/编辑；Host 侧 JSON 权威持久化，单块纯文本随手粘贴。",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "BSD-3-Clause",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "node scripts/check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
